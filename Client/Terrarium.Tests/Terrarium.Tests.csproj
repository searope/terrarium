<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Terrarium.Tests</RootNamespace>
    <AssemblyName>Terrarium.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Game/Game.csproj" />
    <ProjectReference Include="../OrganismBase/OrganismBase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Creature sources compiled by the tests -->
    <None Include="../../Samples/**/*.cs" Exclude="../../Samples/**/obj/**" Link="Creatures/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The creature projects build into creatures/; the tests introduce those assemblies -->
    <ProjectReference Include="../../Samples/**/*.csproj;../../SDK/Solutions/CS/**/*.csproj" ReferenceOutputAssembly="false" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CreaturesFolder</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../creatures'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
