<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Terrarium.Client</RootNamespace>
    <AssemblyName>Terrarium</AssemblyName>
    <ApplicationIcon>tericon32.ico</ApplicationIcon>
    <StartupObject>Terrarium.Client.MainForm</StartupObject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../Graphics/UI/screensaver.png" LogicalName="Terrarium.Client.screensaver.png" />
    <EmbeddedResource Include="../Graphics/UI/splashscreen.png" LogicalName="Terrarium.Client.splashscreen.png" />
    <Content Include="../Graphics/SpriteSheets/*.bmp" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Configuration/Configuration.csproj" />
    <ProjectReference Include="../Controls/Controls.csproj" />
    <ProjectReference Include="../Game/Game.csproj" />
    <ProjectReference Include="../Glass/Glass.csproj" />
    <ProjectReference Include="../OrganismBase/OrganismBase.csproj" />
    <ProjectReference Include="../Renderer/Renderer.csproj" />
  </ItemGroup>
</Project>
